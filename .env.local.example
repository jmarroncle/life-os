# Usa el MISMO proyecto de Supabase que behavioral-design-platform (Project
# Settings > API / Database). Life OS vive en su propio schema de Postgres
# ("life_os", ver src/db/schema.ts) así que no pisa la tabla `public.projects`
# de esa app.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Project Settings > Database > Connection string (usar el pooler
# "Transaction" para serverless/Vercel)
DATABASE_URL=

# URL pública del sitio, usada para el redirect del magic link.
# En local: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Fase 3 ---

# Generación de docs con IA (Data Center → "Generar con IA").
# Conseguila en console.anthropic.com.
ANTHROPIC_API_KEY=

# Crear PRs desde una tarea (Data Center → Tareas → "Crear PR"). Personal
# Access Token de GitHub (fine-grained, scope "Contents" + "Pull requests"
# en Read & Write, solo en los repos que quieras usar). Ver README para el
# porqué de PAT en vez de una GitHub App.
GITHUB_TOKEN=

# Google Calendar (Data Center → Calendario). Crear un proyecto en
# console.cloud.google.com, habilitar la Calendar API, y un OAuth Client ID
# de tipo "Web application" con este Authorized redirect URI:
#   {NEXT_PUBLIC_SITE_URL}/api/google-calendar/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Fase 5: servidor MCP (/api/mcp) ---
# Conecta Life OS como MCP remoto desde un chat (claude.ai, Claude Desktop,
# Claude Code) para leer/crear tareas, páginas, notas y movimientos.
# Ver README → MCP para el paso a paso de conexión.

# Secreto largo y aleatorio — generalo con: openssl rand -hex 32
# Es el Bearer token que vas a pegar en el cliente MCP. No hay OAuth: es
# un solo secreto fijo, como GITHUB_TOKEN (ver README, Life OS es de un
# solo usuario).
MCP_ACCESS_TOKEN=

# Tu user id de Supabase Auth (auth.users.id, un UUID). Se usa para filtrar
# todas las queries del servidor MCP — no hay sesión de cookies acá.
# Lo sacás de Supabase → Authentication → Users, o de la URL cuando abrís
# tu usuario en ese panel.
MCP_USER_ID=
